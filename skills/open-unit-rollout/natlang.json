  "version": "0.1.0",
  "targets": { "main": { "entry": "repairWorkspaceUnit.nl" } },
  "serviceBinding": "explicit",
  "serviceScopes": {
    "unitRolloutCatalog": ["repairWorkspaceUnit.nl"],
