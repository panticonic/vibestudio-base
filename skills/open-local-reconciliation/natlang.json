{
  "schema": "natlang.package/v2",
  "name": "vibestudio-open-local-reconciliation",
  "version": "0.1.0",
  "targets": {
    "main": {
      "entry": "reconcileLocalGoal.nl"
    }
  },
  "serviceBinding": "explicit",
  "serviceScopes": {
    "reconciliationWindow": [
      "reconcileLocalGoal/discoverWindow/readWindow.nl",
      "reconcileLocalGoal/prepareEvidence/releaseEvidence.nl"
    ],
    "reconciliationNative": [
      "reconcileLocalGoal/reconcileProject/observeProject.nl",
      "reconcileLocalGoal/reconcileProject/writeResolution.nl"
    ]
  }
}
