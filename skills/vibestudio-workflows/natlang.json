{
  "schema": "natlang.package/v2",
  "name": "vibestudio-workflows",
  "version": "0.1.0",
  "description": "Typed Natlang skills for caller-owned Vibestudio work.",
  "targets": {
    "main": {
      "entry": "runWorkflow.nl"
    }
  },
  "serviceBinding": "explicit",
  "workspaceModules": {
    "runWorkflow/domains/automation": "skills/automations",
    "runWorkflow/domains/automationLifecycle": "skills/automation-lifecycle",
    "runWorkflow/domains/channelAgent": "skills/agents/channel-membership",
    "runWorkflow/domains/conversation": "skills/conversation-evidence-review",
    "runWorkflow/domains/deviceAndTerminal": "skills/device-and-terminal-review",
    "runWorkflow/domains/examples": "skills/examples-review",
    "runWorkflow/domains/gmailReview": "skills/gmail-workflow-review",
    "runWorkflow/domains/google": "skills/google-drive/driveWorkflow",
    "runWorkflow/domains/localModel": "skills/local-model-task",
    "runWorkflow/domains/mediaImport": "skills/media-and-import-review",
    "runWorkflow/domains/news": "skills/news-workflows",
    "runWorkflow/domains/pdfIntake": "skills/pdf-intake",
    "runWorkflow/domains/personal": "skills/personal-workflows",
    "runWorkflow/domains/personalFacility": "skills/personal-facility-review",
    "runWorkflow/domains/problems": "skills/problem-reporting/natlang",
    "runWorkflow/domains/provenance": "skills/provenance-orientation",
    "runWorkflow/domains/publication": "skills/publish-preflight",
    "runWorkflow/domains/research": "skills/research-intake",
    "runWorkflow/domains/runtimeEvidence": "skills/runtime-evidence-review",
    "runWorkflow/domains/scratchHandoff": "skills/scratch-handoff",
    "runWorkflow/domains/sessionTest": "skills/session-test-review",
    "runWorkflow/domains/spectrolite": "skills/spectrolite-review",
    "runWorkflow/domains/system": "skills/system-investigation",
    "runWorkflow/domains/templateCandidate": "skills/template-candidate",
    "runWorkflow/domains/templates": "skills/templates",
    "runWorkflow/domains/testReview": "skills/system-testing/triage",
    "runWorkflow/domains/unitDesign": "skills/workspace-unit-design"
  },
  "serviceScopes": {
    "panelRepair": [
      "runWorkflow/repairPanel.nl",
      "runWorkflow/repairPanel/reproduce.nl",
      "runWorkflow/repairPanel/diagnose.nl",
      "runWorkflow/repairPanel/verifyRepair.nl",
      "runWorkflow/repairPanel/verifyRepair/verifySaveAndDiscard.nl"
    ],
    "panelRepairEdit": [
      "runWorkflow/repairPanel.nl"
    ],
    "unitRepair": [
      "runWorkflow/repairUnit.nl",
      "runWorkflow/repairUnit/diagnose.nl"
    ],
    "unitRepairEdit": [
      "runWorkflow/repairUnit.nl"
    ],
    "projectWorkspace": [
      "runWorkflow/deliverProject.nl"
    ],
    "projectWorkspaceEdit": [
      "runWorkflow/deliverProject.nl"
    ],
    "workspaceIntegration": [
      "runWorkflow/integrateWorkspace.nl"
    ],
    "ownedOperations": [
      "runWorkflow/operate.nl",
      "runWorkflow/operate/incident.nl",
      "runWorkflow/operate/release.nl"
    ],
    "localMessagingRead": [
      "runWorkflow/routeMessage/inspectChannel.nl",
      "runWorkflow/routeMessage/inspectDelivery.nl"
    ],
    "localMessagingSend": [
      "runWorkflow/routeMessage/deliverMessage.nl"
    ]
  }
}
