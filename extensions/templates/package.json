{
  "name": "@workspace-extensions/templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "displayName": "Templates",
    "icon": "./assets/icon.svg",
    "entry": "index.ts",
    "sourcemap": true,
    "extension": {
      "activationEvents": [
        "onInvoke"
      ],
      "methodAuthority": {
        "registry": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "eligible",
            "rationale": "Loads public workspace-template catalog metadata from the selected address."
          }
        },
        "resolveSource": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Websites use the reviewed templates.inspect operation."
          }
        },
        "inspect": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.inspect",
            "resource": {
              "kind": "receiver"
            }
          },
          "website": {
            "kind": "eligible",
            "rationale": "Acquires the exact requested source and returns its verified pin, repository names, and file inventory. Private source metadata is disclosed to the requester; source code is not executed."
          }
        },
        "inspectAuthoring": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Controls workspace source authoring or inspection requiring source disclosure review."
          }
        },
        "authoringParts": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Controls workspace source authoring or inspection requiring source disclosure review."
          }
        },
        "publishAuthoring": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.publish",
            "resource": {
              "kind": "receiver"
            }
          },
          "website": {
            "kind": "closed",
            "reason": "Controls workspace source authoring or inspection requiring source disclosure review."
          }
        },
        "installed": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Controls private workspace template source and its publication."
          }
        },
        "inspectContribution": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Controls private workspace template source and its publication."
          }
        },
        "suggestContribution": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.publish",
            "resource": {
              "kind": "receiver"
            }
          },
          "website": {
            "kind": "closed",
            "reason": "Controls private workspace template source and its publication."
          }
        },
        "prepareUpdate": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.update",
            "resource": {
              "kind": "receiver"
            }
          },
          "website": {
            "kind": "closed",
            "reason": "Controls private workspace template source and its publication."
          }
        },
        "reviewUpdate": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Controls private workspace template source and its publication."
          }
        },
        "resolveUpdate": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.update",
            "resource": {
              "kind": "receiver"
            }
          },
          "website": {
            "kind": "closed",
            "reason": "Controls private workspace template source and its publication."
          }
        },
        "publishUpdate": {
          "effect": {
            "kind": "userland-capability",
            "capability": "workspace.templates.update",
            "resource": {
              "kind": "receiver"
            }
          },
          "website": {
            "kind": "closed",
            "reason": "Controls private workspace template source and its publication."
          }
        },
        "readUpdateFile": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Controls private workspace template source and its publication."
          }
        },
        "publicationRepositories": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Lists private connected GitHub repository metadata."
          }
        },
        "authoringUpstream": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Reads private template upstream metadata."
          }
        },
        "authoringSetup": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Reads private workspace publication metadata."
          }
        },
        "publicationVersion": {
          "effect": {
            "kind": "open"
          },
          "website": {
            "kind": "closed",
            "reason": "Reads private workspace publication metadata."
          }
        }
      }
    },
    "authority": {
      "provides": [
        {
          "name": "workspace.templates.publish",
          "title": "Publish workspace snapshot",
          "action": "publish this workspace source as an upstream template",
          "tier": "gated",
          "sensitivity": "write",
          "resourceType": "workspace.templates",
          "presentation": {
            "domain": "sharing",
            "verb": "act"
          },
          "notability": "headline",
          "grantScopes": [
            "once",
            "task",
            "session"
          ]
        },
        {
          "name": "workspace.templates.inspect",
          "title": "Inspect a template source",
          "action": "inspect the requested template source",
          "description": "Acquires the exact requested source and returns its verified pin, repository names, and file inventory. Private source metadata is disclosed to the requester; source code is not executed.",
          "tier": "gated",
          "sensitivity": "read",
          "resourceType": "workspace.templates",
          "presentation": {
            "domain": "sharing",
            "verb": "see"
          },
          "notability": "headline",
          "grantScopes": [
            "once",
            "session"
          ]
        },
        {
          "name": "workspace.templates.update",
          "title": "Update workspace template",
          "action": "review and apply template source changes",
          "tier": "gated",
          "sensitivity": "write",
          "resourceType": "workspace.templates",
          "presentation": {
            "domain": "files",
            "verb": "act"
          },
          "notability": "headline",
          "grantScopes": [
            "once",
            "task",
            "session"
          ]
        }
      ],
      "requests": [
        {
          "capability": "credential.use",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "network.response.read",
          "resource": {
            "kind": "origin",
            "origin": "https://github.com"
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "network.response.read",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "git.publish",
          "resource": {
            "kind": "prefix",
            "prefix": "workspace-source-change:"
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": "context/template-update-"
          },
          "tier": "critical",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": "context/template-publication-"
          },
          "tier": "critical",
          "evidence": "bounded-dynamic"
        }
      ]
    }
  },
  "dependencies": {
    "@vibestudio/content-addressing": "workspace:*",
    "@vibestudio/credential-client": "workspace:*",
    "@vibestudio/git": "workspace:*",
    "@vibestudio/service-schemas": "workspace:*",
    "@vibestudio/workspace": "workspace:*",
    "@vibestudio/workspace-contracts": "workspace:*",
    "yaml": "^2.8.0",
    "@vibestudio/shared": "workspace:*",
    "@workspace/integrations": "workspace:*"
  }
}
