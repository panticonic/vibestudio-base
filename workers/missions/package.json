{
  "name": "@workspace-workers/missions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "title": "Automations",
    "icon": "🎯",
    "kind": "worker",
    "entry": "index.ts",
    "durable": {
      "classes": [
        {
          "className": "MissionsDO",
          "rpcSchema": "vibestudio.missions.v1"
        }
      ]
    },
    "authority": {
      "provides": [
        {
          "name": "missions.edit",
          "title": "Change an automation",
          "action": "create or change a running automation",
          "tier": "gated",
          "sensitivity": "write",
          "resourceType": "mission",
          "presentation": {
            "domain": "automation",
            "verb": "manage"
          },
          "notability": "headline",
          "grantScopes": [
            "once"
          ]
        },
        {
          "name": "missions.run",
          "title": "Run an automation",
          "action": "run an installed automation",
          "tier": "gated",
          "sensitivity": "write",
          "resourceType": "mission",
          "presentation": {
            "domain": "automation",
            "verb": "act"
          },
          "notability": "headline",
          "grantScopes": [
            "once"
          ]
        },
        {
          "name": "missions.retire",
          "title": "Remove an automation",
          "action": "permanently remove an automation",
          "tier": "critical",
          "sensitivity": "destructive",
          "resourceType": "mission",
          "presentation": {
            "domain": "automation",
            "verb": "manage"
          },
          "notability": "headline",
          "grantScopes": [
            "once"
          ]
        }
      ],
      "serviceRequests": [
        {
          "protocol": "vibestudio.gad.workspace.v1",
          "availability": "required"
        }
      ],
      "requests": [
        {
          "capability": "workspace-service:gad.workspace",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        }
      ]
    },
    "services": [
      {
        "action": "manage automated tasks",
        "authority": {
          "binding": "declared",
          "principals": [
            "host",
            "user",
            "code"
          ]
        },
        "description": "Launch automated tasks immediately, then inspect and control their running definitions.",
        "durableObject": {
          "className": "MissionsDO"
        },
        "name": "missions",
        "notability": "headline",
        "presentation": {
          "domain": "automation",
          "verb": "manage"
        },
        "protocols": [
          "vibestudio.missions.v1"
        ],
        "title": "Automated tasks"
      }
    ]
  },
  "dependencies": {
    "@vibestudio/automation": "workspace:*",
    "@vibestudio/content-addressing": "workspace:*",
    "@vibestudio/rpc": "workspace:*",
    "@vibestudio/service-schemas": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@workspace/runtime": "workspace:*"
  },
  "devDependencies": {
    "@vibestudio/durable": "workspace:*",
    "vitest": "^3.2.7"
  }
}
