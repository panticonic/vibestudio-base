{
  "name": "@workspace-workers/model-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "title": "Model Gateway",
    "icon": "./assets/icon.svg",
    "kind": "worker",
    "entry": "index.ts",
    "durable": {
      "classes": [
        {
          "className": "ModelGatewayDO"
        }
      ]
    },
    "tests": [
      {
        "name": "native",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "authority": {
      "provides": [],
      "serviceRequests": [
        {
          "protocol": "vibestudio.models.v1",
          "availability": "required"
        }
      ],
      "requests": [
        {
          "capability": "credential.use",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "model.use",
          "resource": {
            "kind": "prefix",
            "prefix": "model:"
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "internal-model-runtime.use",
          "resource": {
            "kind": "exact",
            "key": "local-models"
          },
          "tier": "gated",
          "evidence": "exact"
        },
        {
          "capability": "workspace-service:models",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    },
    "services": [
      {
        "action": "run AI model turns for your workspace's programs",
        "authority": {
          "binding": "declared",
          "principals": [
            "host",
            "user",
            "code",
            "session",
            "mission"
          ]
        },
        "description": "Run one AI model turn, with tools, for an authorized caller. Provider credentials and model approvals stay with the host.",
        "durableObject": {
          "className": "ModelGatewayDO"
        },
        "name": "model-gateway",
        "notability": "everyday",
        "presentation": {
          "domain": "automation",
          "verb": "act"
        },
        "protocols": [
          "vibestudio.model-gateway.v1"
        ],
        "title": "AI model gateway"
      }
    ]
  },
  "dependencies": {
    "@panticonic/pi-ai": "1.2.0-vibestudio.3",
    "@panticonic/pi-chord": "1.2.0-vibestudio.3",
    "@panticonic/pi-durable": "1.2.0-vibestudio.3",
    "@vibestudio/rpc": "workspace:*",
    "@vibestudio/service-schemas": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@workspace/agentic-do": "workspace:*",
    "@workspace/model-catalog": "workspace:*",
    "@workspace/model-gateway": "workspace:*",
    "@workspace/natlang-pi": "workspace:*",
    "@workspace/runtime": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  },
  "exports": {
    ".": "./index.ts"
  }
}
