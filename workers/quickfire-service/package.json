{
  "name": "@workspace-workers/quickfire-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "title": "Quickfire Sessions",
    "icon": "./assets/icon.svg",
    "kind": "worker",
    "entry": "index.ts",
    "durable": {
      "classes": [
        {
          "className": "QuickfireSessionsDO"
        }
      ]
    },
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "workspace.runtime-state.manage",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    },
    "services": [
      {
        "action": "manage panel-bound command conversations",
        "authority": {
          "binding": "declared",
          "principals": [
            "host",
            "user",
            "code"
          ]
        },
        "description": "Owns durable Quickfire conversations attached to panel slots.",
        "durableObject": {
          "className": "QuickfireSessionsDO"
        },
        "name": "quickfire",
        "notability": "everyday",
        "presentation": {
          "domain": "automation",
          "verb": "manage"
        },
        "protocols": [
          "vibestudio.quickfire.v1"
        ],
        "title": "Command conversations"
      }
    ]
  },
  "dependencies": {
    "@workspace/agentic-core": "workspace:*",
    "@workspace/quickfire-core": "workspace:*",
    "@workspace/model-catalog": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  },
  "exports": {
    "./contract": "./contract.ts",
    ".": "./index.ts"
  }
}
