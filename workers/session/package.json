{
  "name": "@workspace-workers/session",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "title": "Session",
    "icon": "\ud83d\uddd2\ufe0f",
    "kind": "worker",
    "entry": "index.ts",
    "durable": {
      "classes": [
        {
          "className": "SessionDO",
          "hosts": [
            {
              "source": "workers/eval-kernel",
              "className": "EvalKernel"
            }
          ]
        }
      ]
    },
    "tests": [
      {
        "name": "native",
        "runtime": "native",
        "include": [
          "**/*.test.ts"
        ]
      }
    ],
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": "context"
          },
          "tier": "critical",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "external.open",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@vibestudio/durable": "workspace:*",
    "@vibestudio/rpc": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@workspace/runtime": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
