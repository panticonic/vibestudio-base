{
 "inspectAuthoring": {
  "description": "Build a reviewed dependency-aware template plan from protected-main workspace source.",
  "access": {
   "sensitivity": "read"
  },
  "argsSchema": {
   "type": "array",
   "minItems": 1,
   "maxItems": 1,
   "items": [
    {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "description": {
       "type": "string",
       "minLength": 1
      },
      "parts": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "name",
      "description",
      "parts"
     ],
     "additionalProperties": false
    }
   ]
  },
  "returnsSchema": {
   "type": "object",
   "properties": {
    "request": {
     "type": "object",
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "description": {
       "type": "string",
       "minLength": 1
      },
      "parts": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "required": [
      "name",
      "description",
      "parts"
     ],
     "additionalProperties": false
    },
    "mainEventId": {
     "type": "string",
     "minLength": 1
    },
    "selectableParts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "requestedParts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "includedParts": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "requiredParts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "manifest": {
     "type": "string",
     "minLength": 1
    },
    "manifestDigest": {
     "type": "string",
     "pattern": "^v1-sha256:[0-9a-f]{64}$"
    },
    "fingerprint": {
     "$ref": "#/properties/manifestDigest"
    }
   },
   "required": [
    "request",
    "mainEventId",
    "selectableParts",
    "requestedParts",
    "includedParts",
    "requiredParts",
    "manifest",
    "manifestDigest",
    "fingerprint"
   ],
   "additionalProperties": false
  }
 }
}