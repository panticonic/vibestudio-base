          "protocol": "vibestudio.natlang.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.models.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.model-gateway.v1",
          "availability": "required"
        }
      ],
      "requests": [
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": "context"
          },
          "tier": "critical",
