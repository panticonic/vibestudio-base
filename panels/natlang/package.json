        {
          "capability": "workspace.runtime-state.manage",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@vibestudio/rpc": "workspace:*",
    "@vibestudio/service-schemas": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@workspace/model-catalog": "workspace:*",
    "@workspace/natlang": "workspace:*",
    "@workspace/natlang-records": "workspace:*",
    "@workspace/natlang-services": "workspace:*",
    "@workspace/react": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
