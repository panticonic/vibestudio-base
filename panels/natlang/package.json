{
  "name": "@workspace-panels/natlang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "title": "Natlang",
    "icon": "./assets/icon.svg",
    "entry": "index.tsx",
    "exposeModules": [
      "react",
      "react/jsx-runtime",
      "react/jsx-dev-runtime",
      "@workspace/runtime",
      "@workspace/react"
    ],
    "authority": {
      "provides": [],
