    "./panel-import-loader": "./src/panel-import-loader.ts",
    "./subagent-prompt": "./src/subagent-prompt.ts",
    "./result-images": "./src/result-images.ts",
    "./native-channel-knowledge": "./src/native-channel-knowledge.ts",
    "./agent-product-metadata": "./src/agent-product-metadata.ts",
    "./model-failures": "./src/model-failures.ts",
    "./agent-channel-roster": "./src/agent-channel-roster.ts"
  },
  "dependencies": {
    "@vibestudio/module-imports": "workspace:*",
